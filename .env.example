# Copie este arquivo para .env e ajuste os valores (o .env NAO vai para o git)

# Banco PostgreSQL (a URL abaixo funciona com o container Docker do README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cjr_trainee?schema=public"

# Porta da API (o front Next.js usa a 3000)
PORT=3001

# URL do front, liberada no CORS
FRONTEND_URL="http://localhost:3000"

# Segredo para assinar os tokens JWT (troque por uma string longa e aleatoria)
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="1d"
